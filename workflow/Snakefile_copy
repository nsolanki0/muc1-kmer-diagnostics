# ============================================================
# STEP 15B: KMC Samples
# ============================================================
def get_kmc_samples(wildcards):
    checkpoint_result = checkpoints.make_kmc_sample_manifest.get()
    manifest = checkpoint_result.output.manifest
    samples = []
    with open(manifest) as f:
        reader = csv.DictReader(f, delimiter="\t")
        required_columns = {"ID", "R1", "R2", "type"}
        if not required_columns.issubset(reader.fieldnames or set()):
            raise ValueError(
                f"KMC manifest must contain columns: "
                f"{sorted(required_columns)}; "
                f"found: {reader.fieldnames}"
            )
        for row in reader:
            sample_id = row["ID"]
            sample_type = row["type"]

            # IMPORTANT:
            # sample_type is intentionally restricted to pos|neg.
            if sample_type not in {"pos", "neg"}:
                raise ValueError(
                    f"Invalid sample type '{sample_type}' "
                    f"for ID '{sample_id}'. "
                    f"Expected 'pos' or 'neg'."
                )

            samples.append((sample_id, sample_type))
    return samples


# ============================================================
# STEP 15C: KMC counting rule
# ============================================================
rule kmc_count:
    input:
        manifest=KMC_SAMPLE_MANIFEST
    output:
        csv=f"{KMER_TABLE}/kmer_counts/{{sample_id}}_{{sample_type}}_k{{k}}.csv"
    wildcard_constraints:
        sample_type="pos|neg",
        k="23|31"

    threads: 6

    resources:
        mem_mb=24576,
        runtime=370

    shell:
        r"""
        set -euo pipefail

        module load kmc/3.2.4-mcmesu/gcc

        mkdir -p "$(dirname "{output.csv}")"

        # ----------------------------------------------------
        # Identify sample
        # ----------------------------------------------------
        ID="{wildcards.sample_id}"
        K="{wildcards.k}"
        TYPE="{wildcards.sample_type}"

        # ----------------------------------------------------
        # Find sample in manifest
        # ----------------------------------------------------
        LINE=$(awk -F'\t' \
            -v id="$ID" \
            -v type="$TYPE" \
            'NR > 1 && $1 == id && $4 == type {{
                print $0
                exit
            }}' \
            "{input.manifest}")

        if [[ -z "$LINE" ]]; then
            echo "ERROR: No KMC manifest entry found:"
            echo "ID=$ID"
            echo "type=$TYPE"
            exit 1
        fi

        R1=$(echo "$LINE" | cut -f2)
        R2=$(echo "$LINE" | cut -f3)

        if [[ ! -s "$R1" ]]; then
            echo "ERROR: R1 missing or empty: $R1" >&2
            exit 1
        fi

        if [[ ! -s "$R2" ]]; then
            echo "ERROR: R2 missing or empty: $R2" >&2
            exit 1
        fi

        # ----------------------------------------------------
        # Job-specific temporary directory
        # ----------------------------------------------------
        TMP_DIR="kmc_tmp_${{ID}}_${{TYPE}}_k${{K}}"
        mkdir -p "$TMP_DIR"

        DB_R1="${{TMP_DIR}}/kmc_db_${{ID}}_r1_k${{K}}"
        DB_R2="${{TMP_DIR}}/kmc_db_${{ID}}_r2_k${{K}}"

        TMP_R1="${{TMP_DIR}}/r1_dump.txt"
        TMP_R2="${{TMP_DIR}}/r2_dump.txt"

        # ----------------------------------------------------
        # R1
        # ----------------------------------------------------
        kmc \
            -k"$K" \
            -ci5 \
            -m4 \
            -t"{threads}" \
            -fq \
            "$R1" \
            "$DB_R1" \
            "$TMP_DIR"

        kmc_tools transform \
            "$DB_R1" \
            dump \
            "$TMP_R1"

        # ----------------------------------------------------
        # R2
        # ----------------------------------------------------
        kmc \
            -k"$K" \
            -ci5 \
            -m4 \
            -t"{threads}" \
            -fq \
            "$R2" \
            "$DB_R2" \
            "$TMP_DIR"

        kmc_tools transform \
            "$DB_R2" \
            dump \
            "$TMP_R2"

        # ----------------------------------------------------
        # Combine R1 + R2 counts
        # ----------------------------------------------------
        {{
            echo "ID,kmer_seq,count,type"

            awk \
                -v id="$ID" \
                -v type="$TYPE" \
                '
                {{
                    count[$1] += $2
                }}

                END {{
                    for (kmer in count)
                        print id "," kmer "," count[kmer] "," type
                }}
                ' \
                "$TMP_R1" "$TMP_R2"

        }} > "{output.csv}"

        # ----------------------------------------------------
        # Cleanup
        # ----------------------------------------------------
        rm -rf "$TMP_DIR"

        echo "Created:"
        echo "{output.csv}"
        """


