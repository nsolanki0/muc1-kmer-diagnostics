# ============================================================
# STEP 1: Find MUC1 contigs in GFF files
# ============================================================
rule find_muc1_contigs:
    input:
        gff_dir=GFF_DIR
    output:
        f"{DISCOVERY}/MUC1_contigs.txt"
    shell:
        r"""
        mkdir -p $(dirname {output})
        echo -e "GFF_file_path\tContig" > {output}
        for file in {input.gff_dir}/*.gff3.gz; do
            zcat "$file" | grep -w "MUC1" | cut -f1 | sort -u | while read -r contig; do
                    echo -e "$file\t$contig" >> {output}
                done
        done
        """


# ============================================================
# STEP 2: Match FASTA and GFF paths
# ============================================================
checkpoint match_fasta_gff:
    input:
        gff_contigs=rules.find_muc1_contigs.output
    output:
        f"{DISCOVERY}/matched_paths_with_contig.txt"
    params:
        fasta_dir=FASTA_DIR
    shell:
        r"""
        mkdir -p $(dirname {output})

        echo -e "FASTA_file_path\tGFF_file_path\tContig" > {output}

        tail -n +2 {input.gff_contigs} |
        while IFS=$'\t' read -r gff_path contig; do
            accession=$(basename "$gff_path" .gff3.gz)
            fasta_path="{params.fasta_dir}/${{accession}}.unmasked.fa.gz"
            if [[ -f "$fasta_path" ]]; then
                echo -e "$fasta_path\t$gff_path\t$contig" >> {output}
            else
                echo "WARNING: FASTA not found for $accession" >&2
                echo "Expected: $fasta_path" >&2
            fi
        done
        """


# ============================================================
# STEP 3 & 4: Extract chr1 contig (FASTA + GFF)
# ============================================================
# --- Get samples dynamically from Step 2 ---
def get_muc1_samples(wildcards):
    matched_file = checkpoints.match_fasta_gff.get().output[0]
    samples = []
    with open(matched_file) as f:
        next(f)  # Skip header
        for line in f:
            line = line.strip()
            if not line:
                continue
            fasta_path, gff_path, contig = line.split("\t")

            # Example:
            # GCA_041900105.1.unmasked.fa.gz
            #
            # becomes:
            # GCA_041900105.1

            fasta_name = fasta_path.split("/")[-1]
            sample = fasta_name.replace(
                ".unmasked.fa.gz",
                ""
            )
            samples.append(sample)
    return samples

# --- Extract FASTA + GFF ---
rule extract_chr1_contig:
    input:
        matched=rules.match_fasta_gff.output
    output:
        fasta=f"{CHR1_DATA}/{{sample}}_chr1.fa",
        gff=f"{CHR1_DATA}/{{sample}}_chr1.gff.gz"

    wildcard_constraints:
        sample=r"GCA_[0-9]+\.[0-9]+"

    threads: 1

    resources:
        mem_mb=12000,
        runtime=5

    shell:
        r"""
        mkdir -p $(dirname {output.fasta})

        # Find the line corresponding to this sample
        LINE=$(awk -F'\t' -v sample="{wildcards.sample}" '
            NR > 1 {{
                fasta=$1
                gsub(/^.*\//, "", fasta)
                gsub(/\.unmasked\.fa\.gz$/, "", fasta)

                if (fasta == sample) {{
                    print $0
                    exit
                }}
            }}
        ' {input.matched})

        # Check that the sample was found
        if [[ -z "$LINE" ]]; then
            echo "ERROR: No entry found for {wildcards.sample}" >&2
            exit 1
        fi

        # Extract columns
        FASTA=$(echo "$LINE" | cut -f1)
        GFF=$(echo "$LINE" | cut -f2)
        CONTIG=$(echo "$LINE" | cut -f3)

        echo "=================================================="
        echo "Sample:  {wildcards.sample}"
        echo "FASTA:   $FASTA"
        echo "GFF:     $GFF"
        echo "Contig:  $CONTIG"
        echo "=================================================="

        # Extract FASTA contig
        "{NEAT_PYTHON}" "{SCRIPTS}/extract_chr1_contig.py" \
            "$FASTA" \
            "$CONTIG" \
            "{output.fasta}"

        # Extract GFF annotations
        "{NEAT_PYTHON}" "{SCRIPTS}/extract_chr1_contig_gff.py" \
            "$GFF" \
            "$CONTIG" \
            "{output.gff}"
        """


# ============================================================
# STEP 5: Create FASTA/GFF pairs manifest
# ============================================================
def chr1_outputs(wildcards):
    samples = get_muc1_samples(wildcards)
    outputs = []

    for sample in samples:
        outputs.append(
            f"{CHR1_DATA}/{sample}_chr1.fa"
        )
        outputs.append(
            f"{CHR1_DATA}/{sample}_chr1.gff.gz"
        )

    return outputs

rule make_chr1_fa_gff_manifest:
    input:
        chr1_files=chr1_outputs
    output:
        STEP5_PAIRS

    shell:
        r"""
        set -euo pipefail

        mkdir -p "$(dirname "{output}")"

        echo -e "Sample\tFASTA\tGFF" > "{output}"

        for fasta in {CHR1_DATA}/*_chr1.fa; do

            [ -e "$fasta" ] || continue

            fasta_base=$(basename "$fasta" _chr1.fa)
            gff="{CHR1_DATA}/${{fasta_base}}_chr1.gff.gz"

            if [[ -f "$gff" ]]; then
                echo -e "${{fasta_base}}\t${{fasta}}\t${{gff}}" \
                    >> "{output}"
            else
                echo "WARNING: GFF not found for ${{fasta_base}}" >&2
            fi

        done
        """


# ============================================================
# STEP 6: Mutate MUC1 (Positive Samples)
# ============================================================
rule mutate_positive:
    input:
        pairs=STEP5_PAIRS
    output:
        manifest=f"{POS_MANIFEST_DIR}/{{sample}}.txt"

    params:
        motif=MOTIF_FILE,
        output_dir=MUC1_VARIANTS

    shell:
        r"""
        set -euo pipefail

        mkdir -p "{params.output_dir}"
        mkdir -p "$(dirname {output.manifest})"

        # Find FASTA/GFF pair for this sample
        LINE=$(awk -F'\t' -v sample="{wildcards.sample}" '
            NR > 1 && $1 == sample {{
                print $0
                exit
            }}
        ' {input.pairs})

        if [[ -z "$LINE" ]]; then
            echo "ERROR: No FASTA/GFF pair found for {wildcards.sample}" >&2
            exit 1
        fi

        FASTA=$(echo "$LINE" | cut -f2)
        GFF=$(echo "$LINE" | cut -f3)

        echo "=================================================="
        echo "Positive sample: {wildcards.sample}"
        echo "FASTA: $FASTA"
        echo "GFF:   $GFF"
        echo "=================================================="

        # Run mutation script
        "{NEAT_PYTHON}" "{SCRIPTS}/mutate_muc1.py" \
            "$FASTA" \
            "$GFF" \
            --motif-file "{params.motif}" \
            --output "{params.output_dir}/{wildcards.sample}_chr1_mutated.fa" \
            --bed-output "{params.output_dir}/{wildcards.sample}_chr1_muc1M_exons.bed" \
            --gene-region-output "{params.output_dir}/{wildcards.sample}_chr1_gene_region.fa.gz"

        # Find the newly generated files.
        #
        # Python script adds the mutation name and _at_
        # coordinates to the FASTA and gene-region filenames.
        #
        # The BED filename is deterministic.

        BED_FILE=$(find "{params.output_dir}" -maxdepth 1 -type f \
            -name "{wildcards.sample}_chr1_muc1M_exons.bed" \
            -print -quit)

        MUT_FA=$(find "{params.output_dir}" -maxdepth 1 -type f \
            -name "{wildcards.sample}_chr1_*_at_*.fa" \
            -print -quit)

        GENE_FA=$(find "{params.output_dir}" -maxdepth 1 -type f \
            -name "{wildcards.sample}_chr1_*_gene_region_*.fa.gz" \
            -print -quit)

        if [[ -z "$MUT_FA" ]]; then
            echo "ERROR: Mutated FASTA not found for {wildcards.sample}" >&2
            exit 1
        fi

        if [[ -z "$BED_FILE" ]]; then
            echo "ERROR: BED file not found for {wildcards.sample}" >&2
            exit 1
        fi

        if [[ -z "$GENE_FA" ]]; then
            echo "ERROR: Gene-region FASTA not found for {wildcards.sample}" >&2
            exit 1
        fi

        # Create explicit manifest
        {{
            echo -e "Sample\tFASTA\tBED\tGENE_REGION"
            echo -e "{wildcards.sample}\t$MUT_FA\t$BED_FILE\t$GENE_FA"
        }} > {output.manifest}

        echo "Manifest created:"
        cat {output.manifest}
        """

