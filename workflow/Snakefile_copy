        runtime=210

    params:
        output_dir=f"{POSITIVE}/neat"

    shell:
        r"""
        set -euo pipefail

        mkdir -p "{params.output_dir}"

        BED=$(awk -F'\t' 'NR == 2 {{print $2}}' {input.manifest})
