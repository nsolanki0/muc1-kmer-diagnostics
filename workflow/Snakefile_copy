# STEP 14G: Create validated positive Sharked manifest
#
# The manifest is built ONLY from successfully completed
# validate_sharked_positive markers.
#
# It does NOT independently rediscover validity.
# ============================================================
rule make_positive_sharked_manifest:
    input:
        valid=positive_sharked_valid_markers
    output:
        manifest=SHARKED_POS_MANIFEST

    shell:
        r"""
        set -euo pipefail

        mkdir -p "$(dirname "{output.manifest}")"

        echo -e "ID\tR1\tR2\ttype" > "{output.manifest}"

        for marker in {input.valid}; do

            pair_id=$(basename "$marker" .sharked.valid.done)
            pair_id="${{pair_id#positive_}}"

            r1="{SHARKED_POS}/${{pair_id}}_sharked_read1.fq"
            r2="{SHARKED_POS}/${{pair_id}}_sharked_read2.fq"

            # Defensive check:
            # the marker is the validity checkpoint, but make sure
            # the corresponding files still exist.
            if [[ ! -s "$r1" || ! -s "$r2" ]]; then
                echo "ERROR: Sharked marker exists but FASTQ is missing:" >&2
                echo "$pair_id" >&2
                exit 1
            fi

            echo -e "${{pair_id}}\t${{r1}}\t${{r2}}\tpos" \
                >> "{output.manifest}"
        done

        echo "Created positive Sharked manifest:"
        cat "{output.manifest}"
        """


