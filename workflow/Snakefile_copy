# STEP 11C: Diploid manifest readers
# ============================================================
def positive_diploid_pairs(wildcards):
    manifest = checkpoints.make_positive_diploid_manifest.get().output.manifest
    pairs = []
    with open(manifest) as f:
        next(f)
        for line in f:
            line = line.strip()
            if not line:
                continue
            fields = line.split("\t")
            if len(fields) < 5:
                raise ValueError(
                    f"Malformed positive diploid manifest line: {line}"
                )
            pairs.append(fields[0])
    return pairs

def negative_diploid_pairs(wildcards):
    manifest = checkpoints.make_negative_diploid_manifest.get().output.manifest
    pairs = []
    with open(manifest) as f:
        next(f)
        for line in f:
            line = line.strip()
            if not line:
                continue
            fields = line.split("\t")
            if len(fields) < 5:
                raise ValueError(
                    f"Malformed negative diploid manifest line: {line}"
                )
            pairs.append(fields[0])
    return pairs

def get_positive_diploid_inputs(wildcards):
    manifest = checkpoints.make_positive_diploid_manifest.get().output.manifest
    with open(manifest) as f:
        header = next(f, None)
        for line in f:
            fields = line.rstrip("\n").split("\t")
            if len(fields) < 5:
                continue
            if fields[0] == wildcards.pair_id:
                return fields[1], fields[2], fields[3], fields[4]
    raise ValueError(
        f"Pair_ID not found in positive manifest: {wildcards.pair_id}"
    )

def get_negative_diploid_inputs(wildcards):
    manifest = checkpoints.make_negative_diploid_manifest.get().output.manifest
    with open(manifest) as f:
        header = next(f, None)
        for line in f:
